# ============================================================
# 复制为 .env 后填写。未填 Key 也能启动：诊断会降级为“仅检索”。
# ============================================================

# ---------- 大模型 ----------
# auto：按已配置的 Key 自动选择；也可显式写 dashscope / deepseek / openai
LLM_PROVIDER=auto
# 只填一个即可；留空则自动使用「仅检索」模式
DASHSCOPE_API_KEY=
# 或者
# DEEPSEEK_API_KEY=

# 可选：覆盖默认模型与地址
# LLM_MODEL=qwen-plus
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=3000

# ---------- Embedding ----------
# auto：有 DashScope Key 用 text-embedding-v2；否则用离线哈希向量
# 可选值：dashscope / openai / hash
EMBEDDING_PROVIDER=auto
# EMBEDDING_MODEL=text-embedding-v2
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# ---------- 检索与切分 ----------
CHUNK_SIZE=600
CHUNK_OVERLAP=80
RETRIEVER_K=4

# ---------- 官网同步 ----------
CRAWL_DELAY=2.0
CRAWL_RETRIES=3
REQUEST_TIMEOUT=30
# USER_AGENT=Mozilla/5.0 ...

# ---------- PDF 中文字体 ----------
# 留空则自动查找：先 data/fonts，再系统字体（Windows 的 simhei.ttf 等）
PDF_FONT_PATH=

# ---------- 界面 ----------
APP_TITLE=宇树机器人售后 AI 助手
